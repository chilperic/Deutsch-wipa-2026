{
  "module": "production_adjektivdeklination_structured",
  "title": "Production Grammatik · Adjektivdeklination im Beruf",
  "status": "production",
  "cefr_level": "B2",
  "focus_areas": [
    "weak_declension",
    "strong_declension",
    "mixed_declension",
    "nominalized_adjectives"
  ],
  "structural_rules": {
    "masculine": {
      "nominative": {
        "def": "-e",
        "indef": "-er",
        "zero": "-er"
      },
      "accusative": {
        "def": "-en",
        "indef": "-en",
        "zero": "-en"
      },
      "dative": {
        "def": "-en",
        "indef": "-en",
        "zero": "-em"
      },
      "genitive": {
        "def": "-en",
        "indef": "-en",
        "zero": "-en"
      }
    },
    "plural": {
      "nominative": {
        "def": "-en",
        "zero": "-e"
      },
      "dative": {
        "def": "-en",
        "zero": "-en"
      }
    }
  },
  "items": [
