      "module": "production",
      "type": "active_recall",
      "exerciseType": "case_trainer",
      "prompt": "Ein ___ Lieferant bietet bessere Konditionen. (zuverlässig)",
      "answer": "zuverlässiger",
      "choices": [
        "zuverlässiger",
        "zuverlässige",
        "zuverlässigen",
        "zuverlässigem"
      ],
      "explanation": "Indefinite masculine nominative: ein zuverlässiger Lieferant. The article does not show gender clearly, so the adjective carries -er.",
      "example": "Ein zuverlässiger Lieferant kann Lieferengpässe reduzieren.",
      "level": "B2",
      "tags": [
        "adjective_declension",
        "business_cases"
